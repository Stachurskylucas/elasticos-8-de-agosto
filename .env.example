# ============================================================
# VARIABLES DE ENTORNO — ELÁSTICOS 8 DE AGOSTO
# ============================================================

# 1. Credenciales de Supabase (Obtenelas gratis en https://supabase.com)
# En tu dashboard de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Contraseña del Panel de Administrador (/admin)
# Podés cambiarla por la contraseña que vos quieras
# Obligatorias: sin ellas el panel no deja entrar. El secreto: 32+ caracteres al azar
# (por ejemplo, el resultado de: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 3. Estadísticas de la web (tabla eventos_web: correr supabase/eventos_web.sql en Supabase)
# Clave larga al azar (32+ caracteres). La misma se carga en la app de Facturación, sección Web.
STATS_TOKEN=
# Poné 1 para medir también en localhost (por defecto, en local no se mide)
NEXT_PUBLIC_MEDIR_EN_LOCAL=
